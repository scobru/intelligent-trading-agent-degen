# ==============================================================================
# OpenRouter AI Configuration
# ==============================================================================
OPENROUTER_API_KEY="sk-or-v1-tua-chiave-openrouter-qui"
# Modello usato per le decisioni (default: openrouter/free).
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_MAX_ATTEMPTS="3"

# ==============================================================================
# Wallet su Base
# ==============================================================================
# Indirizzo del wallet operativo
WALLET_ADDRESS="0x..."
# Chiave privata del wallet: NON committarla mai.
# Usa un wallet dedicato al bot, con dentro solo il capitale che puoi perdere.
PRIVATE_KEY=""
# RPC di Base (Alchemy, QuickNode, Infura o il pubblico https://mainnet.base.org)
BASE_RPC_URL="https://mainnet.base.org"

# ==============================================================================
# Sicurezza operativa
# ==============================================================================
# true = il ciclo gira ma NON firma nessuna transazione. Parti sempre da qui.
DRY_RUN="true"

# Paper trading: portafoglio virtuale con prezzi e rotte reali. Gli ordini
# vengono eseguiti contro un saldo finto, quindi vedi la strategia lavorare
# (P&L, stop loss, take profit) senza mettere capitale sul wallet.
# Implica sempre DRY_RUN.
PAPER_TRADING="false"
PAPER_START_USDC="1000"
PAPER_START_ETH="0.05"
# Costo del gas simulato per swap, in USD
PAPER_GAS_USD="0.02"
# ETH da non spendere mai, serve per pagare il gas
MIN_ETH_RESERVE="0.0015"
# Slippage massimo consentito, in basis point (300 = 3%)
MAX_SLIPPAGE_BPS="300"
DEFAULT_SLIPPAGE_BPS="150"
# Sopra questo gas price il bot non manda transazioni
MAX_GAS_PRICE_GWEI="0.5"

# ==============================================================================
# Limiti di rischio
# ==============================================================================
# Quota massima del portafoglio su un singolo token
MAX_POSITION_PCT="0.25"
# Numero massimo di token detenuti contemporaneamente
MAX_OPEN_TOKENS="5"
MIN_TRADE_USD="5"
MAX_TRADE_USD="250"
DEFAULT_STOP_LOSS_PCT="20"
DEFAULT_TAKE_PROFIT_PCT="40"
# false per lasciare che sia solo l'LLM a decidere le uscite
AUTO_RISK_EXITS="true"

# ==============================================================================
# Screening dei token (filtri anti-scam)
# ==============================================================================
SCREEN_MAX_CANDIDATES="12"
SCREEN_MIN_LIQUIDITY_USD="250000"
SCREEN_MIN_VOLUME_24H_USD="400000"
SCREEN_MIN_POOL_AGE_DAYS="7"
SCREEN_MAX_TAX_PERCENT="5"
SCREEN_CACHE_SECONDS="1800"
# Durata della cache delle candele: riduce le chiamate alle API pubbliche,
# che hanno rate limit stretti (GeckoTerminal risponde 429 oltre ~30/min)
OHLCV_CACHE_SECONDS="600"
# Indirizzi separati da virgola da escludere sempre
TOKEN_BLOCKLIST=""
# Se valorizzata, il bot tradera' SOLO questi indirizzi
TOKEN_ALLOWLIST=""
# Token da valutare sempre, anche se non emergono fra i piu' scambiati.
# Passano gli stessi filtri di tutti gli altri.
TOKEN_WATCHLIST=""
# Indirizzi che hai verificato a mano: saltano il requisito "presente nella
# token list CoinGecko di Base", ma NON i controlli di mercato e contratto.
TOKEN_TRUSTED=""
# Quanti asset passano per l'analisi tecnica completa a ogni ciclo
MAX_ANALYZED_ASSETS="4"

# ==============================================================================
# Telegram (opzionale)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ==============================================================================
# Runtime
# ==============================================================================
PORT="3000"
TRADING_INTERVAL="900"
# Percorsi dello stato. Lasciali vuoti: il bot usa /app/data da solo quando
# quella cartella esiste (volume persistente CapRover/Docker).
# SQLITE_DB_PATH="/app/data/trading_agent.db"
# POSITIONS_PATH="/app/data/positions.json"
# Fallback per il Fear & Greed se alternative.me non risponde (opzionale)
CMC_PRO_API_KEY=""
